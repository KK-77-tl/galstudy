DATABASE_URL=sqlite:///./data/galstudy.db
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
AUTH_ATTEMPTS_PER_MINUTE=30
AUTH_GLOBAL_ATTEMPTS_PER_MINUTE=120
API_INTERNAL_URL=http://127.0.0.1:8000
OCR_MODE=disabled
OCR_DATA_PATH=data/tessdata
OCR_LANGUAGES=chi_sim+eng
OCR_DPI=180
OCR_MAX_PIXELS=8000000
OCR_MAX_PAGES=10
# Set cloud to enable evidence-validated knowledge and story generation.
LLM_MODE=demo
LLM_API_KEY=
LLM_CHAT_MODE=demo
# Cloud learning/chat need all three values, using your provider's region/workspace docs.
LLM_BASE_URL=
LLM_MODEL=
LLM_CHAT_TIMEOUT_SECONDS=30
LLM_GENERATION_TIMEOUT_SECONDS=45
LLM_DAILY_REQUEST_LIMIT=50
LLM_GLOBAL_DAILY_REQUEST_LIMIT=500
LLM_DAILY_RESERVED_TOKEN_LIMIT=200000
LLM_GLOBAL_DAILY_RESERVED_TOKEN_LIMIT=2000000
IMAGE_GENERATOR=mock
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SECRET=
# Optional: alipay_sandbox or alipay_live. Install requirements-alipay.txt first.
# Live character sales require IMAGE_GENERATOR=comfyui and actual platform eligibility.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
# Optional compose.alipay.yaml: absolute key paths on the Docker host.
ALIPAY_PRIVATE_KEY_HOST_PATH=
ALIPAY_PUBLIC_KEY_HOST_PATH=
CHARACTER_PACK_PRICE_CENTS=990
CHARACTER_EXPRESSION_COUNT=6
CHARACTER_POSE_COUNT=3
REFERENCE_RETENTION_DAYS=7
IMAGE_USER_DAILY_LIMIT=5
IMAGE_GLOBAL_DAILY_LIMIT=20
IMAGE_USER_DAILY_SUBMISSION_LIMIT=15
IMAGE_GLOBAL_DAILY_SUBMISSION_LIMIT=60
IMAGE_JOB_TIMEOUT_SECONDS=300
COMFYUI_BASE_URL=
COMFYUI_WORKFLOW_PATH=backend/workflows/character.template.json
COMFYUI_API_KEY=
WORKSHOP_REVIEW_TOKEN=
# Docker Compose only. Set your own local database password.
POSTGRES_PASSWORD=
